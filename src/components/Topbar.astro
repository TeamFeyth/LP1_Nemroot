---
// Section 5 / 0. Topbar Strip — text verbatim from the spec.
// Emoji icons reproduced from the LP1 HTML draft (lp1-html.html).
const items = [
  { icon: '💎', text: '30-day money-back guarantee' },
  { icon: '⚡', text: 'Live in 24 to 48 hours' },
  { icon: '🏷️', text: 'Save more on annual plans' },
];
---

<div class="topbar">
  {items.map((i) => (
    <div class="ti"><span class="ti-ic" aria-hidden="true">{i.icon}</span>{i.text}</div>
  ))}
</div>

<style>
  .topbar {
    background: var(--accent-glow);
    border-bottom: 1px solid var(--accent-border);
    padding: 9px 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .ti {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.72rem;
    color: var(--accent);
    font-weight: 500;
  }
  .ti-ic { font-size: 0.78rem; line-height: 1; }
  @media (max-width: 640px) {
    .topbar { gap: 14px; padding: 8px 16px; }
  }
</style>
